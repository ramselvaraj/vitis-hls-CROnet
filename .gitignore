# =====================================================================
#  CRONet HLS — combined repo .gitignore
#  Patterns are path-agnostic so they apply inside every variant folder
#  (60x20/, 30x20/, 30x10/) as well as the repo root.
# =====================================================================

# ---- Vitis / HLS build artifacts ----
build/
_x/
.ipcache/
.Xil/
*.xclbin
*.xo
*.xsa
*.ltx
*.bit
*.pdi
*.bin
*.img

# ---- Vitis logs / journals / summaries ----
*.log
*.jou
*.backup.log
*.compile_summary
*.link_summary
*.package_summary
xcd.log
xclbin_info.txt
v++_*.log

# ---- Large data / vector package (regenerate, see data/README.md) ----
data/cronet_hls_fp16_vectors/
*.zip
*.tar.gz

# ---- Generated weight ROM headers (regenerate via scripts/gen_fp16_*.py) ----
include/generated/

# ---- Board hand-off / deliverable packages (large: sd_card.img, xclbin, …) ----
FINAL/
sd_card/
sd_card.img

# ---- Disposable probe / experiment workspaces ----
counter_probe_hls/
counter_compute_only/
counter_cycle_nohang/
host_timer_probe/
hls_latency_dump/
analyzer_input/

# ---- Misc snapshots / baselines ----
bram_snapshot_*.txt
opt*_baseline_*.txt

# ---- Editor / OS ----
*.o
*.exe
*.out
.vscode/
.claude/
.DS_Store
*~
